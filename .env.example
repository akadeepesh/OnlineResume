# Copy to .env.local for development. Every variable is optional;
# blank values count as unset. Validated in src/lib/env.ts.
# Setup guide: docs/SETUP.md

# --- Public (inlined into the browser bundle: never put secrets here) ---

# Base URL of the site. Production: https://resume.akadeepesh.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Template shown at "/": classic | editorial | spotlight | terminal | bento
NEXT_PUBLIC_TEMPLATE=classic

# Floating template picker on "/" and /templates/<slug> (true | false)
NEXT_PUBLIC_SHOW_TEMPLATE_SWITCHER=true

# Live GitHub repo stats on skills (true | false). Portfolio leftover:
# removed when skills link to the user's own projects.
NEXT_PUBLIC_ENABLE_GITHUB_FETCH=false
NEXT_PUBLIC_GH_OWNER=

# --- Server only ---

# Raises GitHub's API rate limit for the repo stats above. Optional.
GITHUB_TOKEN=

# Coming in later PRs (not read yet):
# DATABASE_URL=            # PR 11, Neon Postgres
# BETTER_AUTH_SECRET=      # PR 12
# BETTER_AUTH_URL=         # PR 12
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=   # PR 12
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=   # PR 12 (sign-in + repo import)
# GROQ_API_KEY=            # PR 23, AI import
